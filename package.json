{
  "name": "ritr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preservation-first DOCX workbench",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "vite --host 127.0.0.1",
    "cli": "tsx src/cli.ts",
    "fixtures": "node scripts/fixtures.mjs",
    "check": "npm run format:check && npm test && npm run build",
    "format": "prettier --write src tests scripts fixtures/specs package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check src tests scripts fixtures/specs package.json tsconfig.json vite.config.ts",
    "test:desktop": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "fflate": "^0.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^44.2.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.58.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
